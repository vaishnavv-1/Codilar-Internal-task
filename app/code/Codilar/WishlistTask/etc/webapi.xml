<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/wishlist/add" method="POST">
        <service class="Codilar\WishlistTask\Api\WishlistManagementInterface" method="addProduct"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/wishlist/remove/:itemId" method="DELETE">
        <service class="Codilar\WishlistTask\Api\WishlistManagementInterface" method="removeProduct"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/wishlist/products" method="GET">
        <service class="Codilar\WishlistTask\Api\WishlistManagementInterface" method="getProducts"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/wishlist/move-to-cart/:itemId" method="POST">
        <service class="Codilar\WishlistTask\Api\WishlistManagementInterface" method="moveToCart"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/wishlist/move-to-wishlist/:quoteItemId" method="POST">
        <service class="Codilar\WishlistTask\Api\WishlistManagementInterface" method="moveToWishlist"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
